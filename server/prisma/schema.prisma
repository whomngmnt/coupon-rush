
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims    Claim[]
  campaigns Campaign[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Campaign {
  id           String   @id @default(uuid())
  title        String
  description  String?
  totalCoupons Int
  issuedCount  Int      @default(0)
  startsAt     DateTime
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])

  claims       Claim[]

  @@index([startsAt])
  @@map("campaigns")
}

model Claim {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@map("claims")
}